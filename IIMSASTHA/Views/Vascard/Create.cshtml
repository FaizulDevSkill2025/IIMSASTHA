@model IIMSASTHA.Models.Vascard

@{
    ViewData["Title"] = "Create";
}

<link href="~/css/Vascard.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/fontawesome.min.css" integrity="sha512-M5Kq4YVQrjg5c2wsZSn27Dkfm/2ALfxmun0vUE3mPiJyK53hQBHYCVAtvMYEC7ZXmYLg8DVG4tF8gD27WmDbsg==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

<body2>
    <div class="container">
        <header>Producer  Details</header>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="form first">
                <div class="row">
                    <div class="fields">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="input-field">
                            <label asp-for="Code">Code</label>
                            <input asp-for="Code" type="text" placeholder="Enter Code" />
                        </div>
                        <span asp-validation-for="Code" class="text-danger"></span>

                        <div class="mt-3">
                            <img id="imagePreview" src="#" alt="Image Preview"
                                 style="display:none; max-width:100px; border:1px solid #ddd; padding:5px;" />
                        </div>

                        <div class="input-field">
                            <label asp-for="ImageUrl">Upload Image</label>
                            <input asp-for="ImageUrl" type="file" accept="image/*" onchange="previewImage(event)" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>

                        <div class="input-field">
                            <label asp-for="Name">Name</label>
                            <input asp-for="Name" type="text" placeholder="Enter Producer Name" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>

                        <div class="input-field">
                            <label asp-for="Designation">Designation</label>
                            <input asp-for="Designation" type="text" placeholder="Enter Designation" />
                        </div>
                        <span asp-validation-for="Designation" class="text-danger"></span>

                        <div class="input-field">
                            <label asp-for="Blood">Blood Group</label>
                            <input asp-for="Blood" type="text" placeholder="Enter Blood Group" />
                        </div>
                        <span asp-validation-for="Blood" class="text-danger"></span>

                        <div class="input-field">
                            <label asp-for="JoiningDate">Joining Date</label>
                            <input type="date" asp-for="JoiningDate" class="form-control" />
                        </div>
                        <span asp-validation-for="JoiningDate" class="text-danger"></span>

                        <div class="input-field">
                            <label asp-for="Status">Status</label>
                            <input asp-for="Status" type="text" placeholder="Status" />
                        </div>
                        <span asp-validation-for="Status" class="text-danger"></span>

                        <div class="mt-3">
                            <img id="SignaturePreview" src="#" alt="Signature Preview"
                                 style="display:none; max-width:100px; border:1px solid #ddd; padding:5px;" />
                        </div>

                        <div class="input-field">
                            <label asp-for="SigImageUrl">Upload Signature</label>
                            <input asp-for="SigImageUrl" type="file" accept="image/*" onchange="previewSignature(event)" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>
                </div>
                <div class="button">
                    <input type="submit" value="Save" class="btn btn-primary" /> |
                    <a asp-action="Index" class="btn btn-success">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</body2>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
        $('#JoiningDate').datepicker({
        format: 'yyyy-mm-dd', 
        });
        });
    </script>

    <script>
        function previewImage(event) {
        const input = event.target;
        const preview = document.getElementById('imagePreview')
        if (input.files && input.files[0]) {
        const reader = new FileReader();

        reader.onload = function (e) {
        preview.src = e.target.result;
        preview.style.display = "block";
        }

        reader.readAsDataURL(input.files[0]);
        }
        }
    </script>
    <script>
        function previewSignature(event) {
        const input = event.target;
        const preview = document.getElementById('SignaturePreview')
        if (input.files && input.files[0]) {
        const reader = new FileReader();

        reader.onload = function (e) {
        preview.src = e.target.result;
        preview.style.display = "block";
        }

        reader.readAsDataURL(input.files[0]);
        }
        }
    </script>
}
